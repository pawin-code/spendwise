# SpendWise build-time configuration. Placeholders only — never put real secrets here.
# These are passed to Flutter with --dart-define (they end up in the app binary, so they must
# not be secrets). Example:
#   flutter build appbundle --release \
#     --dart-define=SPENDWISE_MONTHLY_ID=spendwise_pro_monthly \
#     --dart-define=SPENDWISE_ANNUAL_ID=spendwise_pro_annual \
#     --dart-define=SPENDWISE_VERIFY_URL=https://api.example.com \
#     --dart-define=SPENDWISE_SUPPORT_EMAIL=support@example.com

SPENDWISE_PACKAGE=in.creovix.spendwise
SPENDWISE_MONTHLY_ID=spendwise_pro_monthly
SPENDWISE_ANNUAL_ID=spendwise_pro_annual
SPENDWISE_VERIFY_URL=
SPENDWISE_SUPPORT_EMAIL=

# --- Server-side only (NEVER in the app, never committed) ---
# Used by YOUR purchase-verification backend, not by this repository:
# GOOGLE_PLAY_SERVICE_ACCOUNT_JSON_PATH=/secure/path/play-service-account.json

# --- Release signing: put these in android/key.properties (git-ignored) ---
# storePassword=<your keystore password>
# keyPassword=<your key password>
# keyAlias=upload
# storeFile=C:/secure/path/upload-keystore.jks
